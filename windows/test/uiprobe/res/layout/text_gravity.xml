    <TextView android:id="@+id/t4" android:layout_width="match_parent" android:layout_height="48dp" android:hint="@string/he_hint" android:textSize="16sp" android:gravity="center_vertical" />
    <TextView android:id="@+id/t5" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/en_short" android:textSize="16sp" android:textAlignment="viewStart" />
