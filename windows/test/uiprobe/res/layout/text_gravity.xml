    <dev.winapk.probe.ProbeLabel android:id="@+id/t12" android:layout_width="match_parent" android:layout_height="48dp" android:hint="@string/he_hint" />
    <dev.winapk.probe.ProbeLabel android:id="@+id/t13" android:layout_width="match_parent" android:layout_height="48dp" android:text="@string/en_short" />
