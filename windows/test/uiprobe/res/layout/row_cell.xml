<?xml version="1.0" encoding="utf-8"?>
<!-- A grid cell or a strip's card: a picture over a caption. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_margin="4dp"
    app:cardCornerRadius="8dp" app:cardElevation="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical">
        <ImageView android:id="@+id/row_icon" android:layout_width="match_parent" android:layout_height="48dp"
            android:src="@drawable/pic_wide" android:scaleType="centerCrop" />
        <TextView android:id="@+id/row_title" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:padding="6dp" android:maxLines="1"
            android:ellipsize="end" android:textAppearance="?attr/textAppearanceCaption" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
