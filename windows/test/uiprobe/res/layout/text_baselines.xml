<?xml version="1.0" encoding="utf-8"?>
<!-- android:firstBaselineToTopHeight / lastBaselineToBottomHeight: TextView moves its top and bottom
     padding so the first baseline and the last line's bottom land where asked (API 28). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/a" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/en_short" android:textSize="16sp" android:firstBaselineToTopHeight="40dp" />
    <TextView android:id="@+id/b" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/en_short" android:textSize="16sp" android:lastBaselineToBottomHeight="30dp" />
    <TextView android:id="@+id/c" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/en_short" android:textSize="16sp" android:includeFontPadding="false"
        android:firstBaselineToTopHeight="28dp" android:paddingTop="4dp" />
    <TextView android:id="@+id/d" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="@string/en_short" android:textSize="16sp" android:firstBaselineToTopHeight="2dp" />
</LinearLayout>
