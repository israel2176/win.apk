# The Maps probe's settings (maps-probe.yml). Every line is put in the job's
# environment, so a runtime variable set here reaches the app.
# STAGE_RUN: the CI run whose runtime-stage artifact is used; empty = the newest green run on main.
STAGE_RUN=
# How long the app runs, and how often it is sampled (seconds).
RUN_SECONDS=150
SAMPLE_SECONDS=25
MACAPK_TRACE_INVALIDATE=1
# 1: run under cdb and report where the process ends, instead of sampling.
DEBUGGER=1
