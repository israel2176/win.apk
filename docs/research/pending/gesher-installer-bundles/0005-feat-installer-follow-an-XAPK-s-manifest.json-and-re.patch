+                + " \"expansions\": [{\"file\": \"Android/obb/com.example/main.7.com.example.obb\","
+                + " \"install_location\": \"EXTERNAL_STORAGE\", \"install_path\":"
+                + " \"Android/obb/com.example/main.7.com.example.obb\"}], \"name\": \"Ex\\u00e9mple \\\"q\\\"\"}")
